# Root environment for docker-compose.local.yml.
# This is a local development template, not a production secret store. Replace
# placeholder credentials before sharing the machine or exposing any port.

COMPOSE_PROJECT_NAME=cellguard-local

# TimescaleDB is required. Do not replace this image with plain PostgreSQL.
POSTGRES_DB=cellguard
POSTGRES_USER=cellguard
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# Kafka has three advertised paths:
#   - INTERNAL is for Compose services (kafka:29092).
#   - LOCALHOST is for host processes (localhost:9092).
#   - LAN is for the Raspberry Pi. Set this to the host's LAN DNS name or IP
#     in your uncommitted .env; never commit a private address here.
KAFKA_LOCAL_PORT=9092
KAFKA_LAN_PORT=19092
KAFKA_LAN_BIND_ADDRESS=0.0.0.0
KAFKA_LAN_ADVERTISED_HOST=cellguard-host.example.invalid
KAFKA_TOPIC_PARTITIONS=3

# The backend image is built locally from backend/Dockerfile.
BACKEND_PORT=3005
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional AI profile. The paths are only mounted when --profile ai is used.
# The bundle must contain the externally supplied checkpoints/metadata, and the
# adapter package must be installed or mounted; missing either one fails closed.
AI_MODEL_BUNDLE_HOST_PATH=./ai/artifacts
AI_ADAPTER_HOST_PATH=./ai/external
