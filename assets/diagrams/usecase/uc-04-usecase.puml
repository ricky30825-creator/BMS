@startuml
!pragma layout smetana
skinparam backgroundColor transparent
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "AppleGothic"
skinparam defaultFontSize 17
skinparam ActorFontSize 16
skinparam UsecaseFontSize 17
skinparam NoteFontSize 14
skinparam ArrowFontSize 13
skinparam roundcorner 16
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #8EA7C2
  ArrowColor #6B7F99
  FontColor #263238
}
skinparam actor {
  BackgroundColor #FDEBD3
  BorderColor #C58A50
  FontColor #263238
}
skinparam rectangle {
  BackgroundColor #F4F8FF
  BorderColor #9BB6D6
  FontColor #263238
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D9C36A
  FontColor #444444
}
top to bottom direction
skinparam usecase {
  BackgroundColor #FFF4C7
  BorderColor #C6A84F
}
actor "현장 운영자" as A
actor "알림 서버" as S1
actor "Kakao" as S2
actor "릴레이" as S3
rectangle "알림 확인 및 릴레이 차단 대응" {
  usecase "위험 알림 수신" as U1
  usecase "Ack 처리" as U2
  usecase "SOP 확인" as U3
  usecase "재인증" as U4
  usecase "차단 사유 입력" as U5
  usecase "Kill-Switch 실행" as U6
  usecase "감사 로그 저장" as U7
}
U1 -[hidden]down- U2
U2 -[hidden]down- U3
U3 -[hidden]down- U4
U4 -[hidden]down- U5
U5 -[hidden]down- U6
U6 -[hidden]down- U7
A -right-> U1
S1 -left-> U2
S2 -left-> U4
S3 -left-> U6
U1 ..> U2 : <<include>>
U2 ..> U3 : <<include>>
U4 ..> U3 : <<extend>>
U4 ..> U5 : <<include>>
U5 ..> U6 : <<include>>
U7 ..> U6 : <<extend>>
note bottom of U7
Fail-Safe 자동 차단은 승인보다 우선 표시한다
end note
@enduml
