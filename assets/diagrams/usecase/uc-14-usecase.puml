@startuml
!pragma layout smetana
skinparam backgroundColor transparent
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "AppleGothic"
skinparam defaultFontSize 17
skinparam ActorFontSize 16
skinparam UsecaseFontSize 17
skinparam NoteFontSize 14
skinparam ArrowFontSize 13
skinparam roundcorner 16
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #8EA7C2
  ArrowColor #6B7F99
  FontColor #263238
}
skinparam actor {
  BackgroundColor #FDEBD3
  BorderColor #C58A50
  FontColor #263238
}
skinparam rectangle {
  BackgroundColor #F4F8FF
  BorderColor #9BB6D6
  FontColor #263238
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D9C36A
  FontColor #444444
}
top to bottom direction
skinparam usecase {
  BackgroundColor #FFE8D6
  BorderColor #D79A6A
}
actor "관리자" as A
actor "Notice API" as S1
actor "감사 로그" as S2
actor "사용자 화면" as S3
rectangle "공지사항 작성 및 게시" {
  usecase "공지 작성" as U1
  usecase "대상/기간 설정" as U2
  usecase "미리보기" as U3
  usecase "게시 상태 변경" as U4
  usecase "사용자 노출" as U5
  usecase "변경 이력 기록" as U6
  usecase "예약 취소" as U7
}
U1 -[hidden]down- U2
U2 -[hidden]down- U3
U3 -[hidden]down- U4
U4 -[hidden]down- U5
U5 -[hidden]down- U6
U6 -[hidden]down- U7
A -right-> U1
S1 -left-> U2
S2 -left-> U4
S3 -left-> U6
U1 ..> U2 : <<include>>
U2 ..> U3 : <<include>>
U4 ..> U3 : <<extend>>
U4 ..> U5 : <<include>>
U5 ..> U6 : <<include>>
U7 ..> U6 : <<extend>>
note bottom of U7
점검·장애·운영 안내를 사용자에게 노출한다
end note
@enduml
