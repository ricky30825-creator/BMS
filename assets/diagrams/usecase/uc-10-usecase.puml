@startuml
!pragma layout smetana
skinparam backgroundColor #FEFCF8
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "AppleGothic"
skinparam roundcorner 18
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #8EA7C2
  ArrowColor #6B7F99
  FontColor #263238
}
skinparam actor {
  BackgroundColor #FDEBD3
  BorderColor #C58A50
  FontColor #263238
}
skinparam rectangle {
  BackgroundColor #F4F8FF
  BorderColor #9BB6D6
  FontColor #263238
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D9C36A
  FontColor #444444
}
top to bottom direction
skinparam usecase {
  BackgroundColor #FFF4C7
  BorderColor #C6A84F
}
title UC-10\nAI 이중 모델 추론 및 점수 융합
actor "AI 추론 서버" as A
actor "Kafka" as S1
actor "LSTM-AE" as S2
actor "Informer" as S3
rectangle "AI 이중 모델 추론 및 점수 융합" {
  usecase "윈도우 형성" as U1
  usecase "특징 생성" as U2
  usecase "AE 오차 계산" as U3
  usecase "Informe\nr 오차 계산" as U4
  usecase "Score \nFusion" as U5
  usecase "위험 등급 산정" as U6
  usecase "alerts 발행" as U7
}
U1 -[hidden]down- U2
U2 -[hidden]down- U3
U3 -[hidden]down- U4
U4 -[hidden]down- U5
U5 -[hidden]down- U6
U6 -[hidden]down- U7
A -right-> U1
S1 -left-> U2
S2 -left-> U4
S3 -left-> U6
U1 ..> U2 : <<include>>
U2 ..> U3 : <<include>>
U4 ..> U3 : <<extend>>
U4 ..> U5 : <<include>>
U5 ..> U6 : <<include>>
U7 ..> U6 : <<extend>>
note bottom of U7
현재 패턴과 미래 흐름 위험을 함께 반영
end note
@enduml
