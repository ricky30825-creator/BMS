@startuml
!pragma layout smetana
skinparam backgroundColor #FEFCF8
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "AppleGothic"
skinparam defaultFontSize 18
skinparam TitleFontSize 22
skinparam ActorFontSize 17
skinparam UsecaseFontSize 18
skinparam NoteFontSize 15
skinparam ArrowFontSize 14
skinparam roundcorner 18
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #8EA7C2
  ArrowColor #6B7F99
  FontColor #263238
}
skinparam actor {
  BackgroundColor #FDEBD3
  BorderColor #C58A50
  FontColor #263238
}
skinparam rectangle {
  BackgroundColor #F4F8FF
  BorderColor #9BB6D6
  FontColor #263238
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D9C36A
  FontColor #444444
}
top to bottom direction
skinparam usecase {
  BackgroundColor #F4E7FF
  BorderColor #AA8DCC
}
title UC-03\nAI 이상탐지 상세 및 근거 확인
actor "연구·운영자" as A
actor "AI 서버" as S1
actor "DB" as S2
actor "XAI" as S3
rectangle "AI 이상탐지 상세 및 근거 확인" {
  usecase "이상 이벤트 선택" as U1
  usecase "점수 분해" as U2
  usecase "기여 요인 확인" as U3
  usecase "과거 세션 비교" as U4
  usecase "SOH/RUL 확인" as U5
  usecase "조치 판단 기록" as U6
}
U1 -[hidden]down- U2
U2 -[hidden]down- U3
U3 -[hidden]down- U4
U4 -[hidden]down- U5
U5 -[hidden]down- U6
A -right-> U1
S1 -left-> U2
S2 -left-> U4
S3 -left-> U6
U1 ..> U2 : <<include>>
U2 ..> U3 : <<include>>
U4 ..> U3 : <<extend>>
U4 ..> U5 : <<include>>
U5 ..> U6 : <<include>>
note bottom of U6
경고를 설명 가능한 판단 근거로 전환한다
end note
@enduml
