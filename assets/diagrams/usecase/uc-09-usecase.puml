@startuml
!pragma layout smetana
skinparam backgroundColor transparent
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "AppleGothic"
skinparam defaultFontSize 17
skinparam ActorFontSize 16
skinparam UsecaseFontSize 17
skinparam NoteFontSize 14
skinparam ArrowFontSize 13
skinparam roundcorner 16
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #8EA7C2
  ArrowColor #6B7F99
  FontColor #263238
}
skinparam actor {
  BackgroundColor #FDEBD3
  BorderColor #C58A50
  FontColor #263238
}
skinparam rectangle {
  BackgroundColor #F4F8FF
  BorderColor #9BB6D6
  FontColor #263238
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D9C36A
  FontColor #444444
}
top to bottom direction
skinparam usecase {
  BackgroundColor #F4E7FF
  BorderColor #AA8DCC
}
actor "Raspberry Pi" as A
actor "Kafka" as S1
actor "Consumer" as S2
actor "TimescaleDB" as S3
rectangle "센서 Raw 데이터 수집 및 적재" {
  usecase "센서 초기화" as U1
  usecase "100ms 측정" as U2
  usecase "raw 발행" as U3
  usecase "Consumer 수신" as U4
  usecase "세션 태깅" as U5
  usecase "DB 적재" as U6
  usecase "전송 실패 재시도" as U7
}
U1 -[hidden]down- U2
U2 -[hidden]down- U3
U3 -[hidden]down- U4
U4 -[hidden]down- U5
U5 -[hidden]down- U6
U6 -[hidden]down- U7
A -right-> U1
S1 -left-> U2
S2 -left-> U4
S3 -left-> U6
U1 ..> U2 : <<include>>
U2 ..> U3 : <<include>>
U4 ..> U3 : <<extend>>
U4 ..> U5 : <<include>>
U5 ..> U6 : <<include>>
U7 ..> U6 : <<extend>>
note bottom of U7
에지는 raw 값만 전송하고 백엔드가 battery_id를 부여한다
end note
@enduml
