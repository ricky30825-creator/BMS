@startuml
!pragma layout smetana
skinparam backgroundColor #FEFCF8
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "AppleGothic"
skinparam roundcorner 18
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #8EA7C2
  ArrowColor #6B7F99
  FontColor #263238
}
skinparam actor {
  BackgroundColor #FDEBD3
  BorderColor #C58A50
  FontColor #263238
}
skinparam rectangle {
  BackgroundColor #F4F8FF
  BorderColor #9BB6D6
  FontColor #263238
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D9C36A
  FontColor #444444
}
top to bottom direction
skinparam usecase {
  BackgroundColor #FFE8D6
  BorderColor #D79A6A
}
title UC-02\n실시간 관제 및 위험 상태 확인
actor "운영자" as A
actor "WebSocket" as S1
actor "Consumer" as S2
actor "DB" as S3
rectangle "실시간 관제 및 위험 상태 확인" {
  usecase "대시보드 진입" as U1
  usecase "계측값 수신" as U2
  usecase "상태 등급 표시" as U3
  usecase "이상점수 확인" as U4
  usecase "최근 이벤트 확인" as U5
  usecase "대응 화면 이동" as U6
}
U1 -[hidden]down- U2
U2 -[hidden]down- U3
U3 -[hidden]down- U4
U4 -[hidden]down- U5
U5 -[hidden]down- U6
A -right-> U1
S1 -left-> U2
S2 -left-> U4
S3 -left-> U6
U1 ..> U2 : <<include>>
U2 ..> U3 : <<include>>
U4 ..> U3 : <<extend>>
U4 ..> U5 : <<include>>
U5 ..> U6 : <<include>>
note bottom of U6
값·상태만 갱신해 실시간 화면 흔들림을 줄임
end note
@enduml
