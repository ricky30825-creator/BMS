@startuml
!pragma layout smetana
skinparam backgroundColor #FEFCF8
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "AppleGothic"
skinparam defaultFontSize 18
skinparam TitleFontSize 22
skinparam ActorFontSize 17
skinparam UsecaseFontSize 18
skinparam NoteFontSize 15
skinparam ArrowFontSize 14
skinparam roundcorner 18
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #8EA7C2
  ArrowColor #6B7F99
  FontColor #263238
}
skinparam actor {
  BackgroundColor #FDEBD3
  BorderColor #C58A50
  FontColor #263238
}
skinparam rectangle {
  BackgroundColor #F4F8FF
  BorderColor #9BB6D6
  FontColor #263238
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D9C36A
  FontColor #444444
}
top to bottom direction
skinparam usecase {
  BackgroundColor #F4E7FF
  BorderColor #AA8DCC
}
title UC-15\n사용자 계정 활성·정지 관리
actor "관리자" as A
actor "User API" as S1
actor "RBAC" as S2
actor "감사 로그" as S3
rectangle "사용자 계정 활성·정지 관리" {
  usecase "사용자 검색" as U1
  usecase "상세 확인" as U2
  usecase "상태/권한 변경" as U3
  usecase "비밀번호 재설정" as U4
  usecase "사유 입력" as U5
  usecase "접근 제어 반영" as U6
  usecase "자기 정지 차단" as U7
}
U1 -[hidden]down- U2
U2 -[hidden]down- U3
U3 -[hidden]down- U4
U4 -[hidden]down- U5
U5 -[hidden]down- U6
U6 -[hidden]down- U7
A -right-> U1
S1 -left-> U2
S2 -left-> U4
S3 -left-> U6
U1 ..> U2 : <<include>>
U2 ..> U3 : <<include>>
U4 ..> U3 : <<extend>>
U4 ..> U5 : <<include>>
U5 ..> U6 : <<include>>
U7 ..> U6 : <<extend>>
note bottom of U7
계정 변경은 즉시 접근 제어에 반영한다
end note
@enduml
