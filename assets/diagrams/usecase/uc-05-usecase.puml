@startuml
!pragma layout smetana
skinparam backgroundColor #FEFCF8
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "AppleGothic"
skinparam roundcorner 18
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #8EA7C2
  ArrowColor #6B7F99
  FontColor #263238
}
skinparam actor {
  BackgroundColor #FDEBD3
  BorderColor #C58A50
  FontColor #263238
}
skinparam rectangle {
  BackgroundColor #F4F8FF
  BorderColor #9BB6D6
  FontColor #263238
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D9C36A
  FontColor #444444
}
top to bottom direction
skinparam usecase {
  BackgroundColor #E6F2F2
  BorderColor #7FAAAA
}
title UC-05\n추세·이벤트 이력 분석과 내보내기
actor "연구·사용자" as A
actor "조회 API" as S1
actor "파일 생성" as S2
actor "DB" as S3
rectangle "추세·이벤트 이력 분석과 내보내기" {
  usecase "기간 선택" as U1
  usecase "지표 선택" as U2
  usecase "세션 비교" as U3
  usecase "이벤트 필터" as U4
  usecase "그래프 해석" as U5
  usecase "CSV/PD\nF 내보내기" as U6
}
U1 -[hidden]down- U2
U2 -[hidden]down- U3
U3 -[hidden]down- U4
U4 -[hidden]down- U5
U5 -[hidden]down- U6
A -right-> U1
S1 -left-> U2
S2 -left-> U4
S3 -left-> U6
U1 ..> U2 : <<include>>
U2 ..> U3 : <<include>>
U4 ..> U3 : <<extend>>
U4 ..> U5 : <<include>>
U5 ..> U6 : <<include>>
note bottom of U6
실험 보고와 장애 분석에 재사용
end note
@enduml
