@startuml
!pragma layout smetana
skinparam backgroundColor #FEFCF8
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "AppleGothic"
skinparam roundcorner 18
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #8EA7C2
  ArrowColor #6B7F99
  FontColor #263238
}
skinparam actor {
  BackgroundColor #FDEBD3
  BorderColor #C58A50
  FontColor #263238
}
skinparam rectangle {
  BackgroundColor #F4F8FF
  BorderColor #9BB6D6
  FontColor #263238
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D9C36A
  FontColor #444444
}
top to bottom direction
skinparam usecase {
  BackgroundColor #DDF6EC
  BorderColor #74A88C
}
title UC-07\n로그인 및 역할 기반 접근
actor "사용자/관리자" as A
actor "Auth API" as S1
actor "RBAC" as S2
actor "세션 저장소" as S3
rectangle "로그인 및 역할 기반 접근" {
  usecase "이메일 로그인" as U1
  usecase "자격 검증" as U2
  usecase "계정 상태 확인" as U3
  usecase "역할 확인" as U4
  usecase "토큰 발급" as U5
  usecase "역할별 화면 이동" as U6
  usecase "접근 거부 처리" as U7
}
U1 -[hidden]down- U2
U2 -[hidden]down- U3
U3 -[hidden]down- U4
U4 -[hidden]down- U5
U5 -[hidden]down- U6
U6 -[hidden]down- U7
A -right-> U1
S1 -left-> U2
S2 -left-> U4
S3 -left-> U6
U1 ..> U2 : <<include>>
U2 ..> U3 : <<include>>
U4 ..> U3 : <<extend>>
U4 ..> U5 : <<include>>
U5 ..> U6 : <<include>>
U7 ..> U6 : <<extend>>
note bottom of U7
역할별 메뉴와 API 범위를 분리
end note
@enduml
