@startuml
!pragma layout smetana
skinparam backgroundColor #FEFCF8
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "AppleGothic"
skinparam roundcorner 18
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #8EA7C2
  ArrowColor #6B7F99
  FontColor #263238
}
skinparam actor {
  BackgroundColor #FDEBD3
  BorderColor #C58A50
  FontColor #263238
}
skinparam rectangle {
  BackgroundColor #F4F8FF
  BorderColor #9BB6D6
  FontColor #263238
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D9C36A
  FontColor #444444
}
top to bottom direction
skinparam usecase {
  BackgroundColor #DDF6EC
  BorderColor #74A88C
}
title UC-01\n배터리 자산 등록 및 측정 시작
actor "사용자" as A
actor "백엔드" as S1
actor "Consumer" as S2
actor "진단기" as S3
rectangle "배터리 자산 등록 및 측정 시작" {
  usecase "배터리 선택\n/신규 등록" as U1
  usecase "필수 정보 검증" as U2
  usecase "디바이스 ON\nLINE 확인" as U3
  usecase "중복 세션 차단" as U4
  usecase "측정 세션 생성" as U5
  usecase "raw 데이터 태깅" as U6
}
U1 -[hidden]down- U2
U2 -[hidden]down- U3
U3 -[hidden]down- U4
U4 -[hidden]down- U5
U5 -[hidden]down- U6
A -right-> U1
S1 -left-> U2
S2 -left-> U4
S3 -left-> U6
U1 ..> U2 : <<include>>
U2 ..> U3 : <<include>>
U4 ..> U3 : <<extend>>
U4 ..> U5 : <<include>>
U5 ..> U6 : <<include>>
note bottom of U6
재연결 배터리는 수동 선택으로 이력 연속성을 확보
end note
@enduml
