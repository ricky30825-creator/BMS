@startuml
!pragma layout smetana
skinparam backgroundColor #FEFCF8
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "AppleGothic"
skinparam roundcorner 18
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #8EA7C2
  ArrowColor #6B7F99
  FontColor #263238
}
skinparam actor {
  BackgroundColor #FDEBD3
  BorderColor #C58A50
  FontColor #263238
}
skinparam rectangle {
  BackgroundColor #F4F8FF
  BorderColor #9BB6D6
  FontColor #263238
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D9C36A
  FontColor #444444
}
top to bottom direction
skinparam usecase {
  BackgroundColor #D7E9FF
  BorderColor #7EA6CF
}
title UC-06\n관리자 통합 관제 및 감사 추적
actor "관리자" as A
actor "관리 API" as S1
actor "시스템 헬스" as S2
actor "audit_log" as S3
rectangle "관리자 통합 관제 및 감사 추적" {
  usecase "운영 요약 확인" as U1
  usecase "위험 배터리 탐색" as U2
  usecase "사용자/디\n바이스 조회" as U3
  usecase "상태 변경\n 사유 입력" as U4
  usecase "감사 로그 검토" as U5
  usecase "조치 메모 저장" as U6
}
U1 -[hidden]down- U2
U2 -[hidden]down- U3
U3 -[hidden]down- U4
U4 -[hidden]down- U5
U5 -[hidden]down- U6
A -right-> U1
S1 -left-> U2
S2 -left-> U4
S3 -left-> U6
U1 ..> U2 : <<include>>
U2 ..> U3 : <<include>>
U4 ..> U3 : <<extend>>
U4 ..> U5 : <<include>>
U5 ..> U6 : <<include>>
note bottom of U6
관리자 변경은 감사 가능하게 보존
end note
@enduml
