# Copy this file to .env (same directory) and fill in BETTER_AUTH_SECRET.
# See docs/local_run.md for the single-origin local demo (start-local.bat).
NODE_ENV=development
PORT=3005
AUTH_MODE=demo
DATA_MODE=memory
# Required (non-empty) even in DATA_MODE=memory — the schema rejects an empty
# string, but nothing actually connects to it until DATA_MODE=postgres (B1).
# The placeholder below is fine to leave as-is for a memory-mode local demo.
DATABASE_URL=postgres://cellguard:cellguard@localhost:5432/cellguard
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BETTER_AUTH_URL=http://localhost:3005
# Must be a real random string, 32+ characters — not the placeholder below.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── F21 보조배터리 진단 문턱 ─────────────────────────────────────
# `0`은 미설정 sentinel이며 그 안전 계층을 비활성화한다.
# 실측(mode2 스펙 §8 H2·H3)이 끝나면 여기 숫자만 바꾼다 — 코드는 그대로다.
DIAG_SURFACE_CUTOFF_C=0
DIAG_TEMP_SLOPE_C_PER_MIN=0
DIAG_GAS_RAW=0
# 등급 판정의 발열 기울기 상한. 0이면 gradeProvisional=true로 나간다.
DIAG_S1_THERMAL_SLOPE_C_PER_MIN=0
# 부스트 효율 η. 절대 SOH(참고값) 산출에만 쓰며 응답에 동봉된다.
DIAG_ASSUMED_EFFICIENCY=0.88
# 안전 계층(DIAG_TEMP_SLOPE_C_PER_MIN 등)의 응답 창과 노이즈 바닥이다 —
# 위 문턱들과 달리 `0`-미설정 sentinel이 아니라 계층이 동작하려면 항상
# 필요한 운영값이라 실제 기본값을 둔다. 실제 중단 문턱은 여전히
# 미측정(mode2 스펙 §8 H2·H3)이며 이 두 값과는 별개다.
# 최근 몇 ms를 판정에 쓸지 — 개수가 아니라 시간인 이유는 runner.ts 참조
# (tick 주기가 100ms로 바뀌어도 창의 의미가 그대로여야 한다).
DIAG_TEMP_SLOPE_WINDOW_MS=60000
# 창 안에 몇 개 이상 쌓여야 기울기를 낼지 — 최소 2(두 점 차분과 다를 바
# 없어 노이즈에 취약, 스펙 §3-2 ②가 최소자승을 쓰는 이유이기도 하다).
DIAG_TEMP_SLOPE_MIN_SAMPLES=5
