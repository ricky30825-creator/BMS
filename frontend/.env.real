# Used by `npm run dev:real` (`vite --mode real`). Kept in a file instead of a
# `VAR=value vite` prefix so the script also runs in Windows cmd/PowerShell —
# the host PC is Windows. Points the dev server at a real backend on :3005.
# Mode `real` is not `development`, so the MSW worker is never started.
VITE_API_BASE=http://127.0.0.1:3005
VITE_DEMO_MODE=true
VITE_USE_MOCKS=false
