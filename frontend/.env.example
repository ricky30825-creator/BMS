# `npm run dev` keeps MSW fixtures available for mock UI/E2E work. For a real
# local demo, start the backend in DEMO_MODE and use `npm run dev:real`.
#
# `npm run build` does NOT read this file — it loads .env.production instead
# (Vite's mode=production default), which bakes in the single-origin local
# demo config. See docs/local_run.md.
VITE_API_BASE=
VITE_DEMO_MODE=false
VITE_USE_MOCKS=false
