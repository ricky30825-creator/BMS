# Used automatically by `npm run build` (Vite defaults to mode=production).
# Bakes in the single-origin CellGuard demo deployment: the built SPA is
# served by the backend itself (see docs/local_run.md), so API calls are
# same-origin relative paths and no dev-only mock worker is bundled.
VITE_API_BASE=
VITE_DEMO_MODE=true
VITE_USE_MOCKS=false
