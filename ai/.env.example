# Copy these values into the host process environment when running the optional
# AI process outside Compose. The runtime defaults to production and exits
# before Kafka if the external model bundle or adapter is absent.
AI_ENV=production
AI_MODEL_BUNDLE_DIR=/replace/with/approved/model-bundle
# A host process uses the localhost listener. Compose uses kafka:29092 and the
# Raspberry Pi uses the separately advertised LAN listener (see docs/local_run.md).
AI_KAFKA_BROKERS=127.0.0.1:9092
AI_KAFKA_CLIENT_ID=cellguard-ai-inference
AI_KAFKA_GROUP_ID=cellguard-ai-inference
AI_RAW_TOPIC=battery-raw-metrics
AI_ANOMALY_TOPIC=battery-anomaly-alerts
AI_POLL_TIMEOUT_MS=1000
AI_PUBLISH_TIMEOUT_MS=10000

# No fake/mock adapter flag is supported. The adapter is named by the approved
# bundle metadata and must be an installed `python:module:factory` implementation.
