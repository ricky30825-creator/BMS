# Raspberry Pi command-consumer template. This file is safe to commit.
# The Pi must use the host's advertised LAN listener, never localhost:9092.
EDGE_ENV=production
EDGE_GPIO_BACKEND=rpi
EDGE_HARDWARE_PROFILE=MODE1_EXTERNAL_CELL_V1
EDGE_KAFKA_BROKERS=cellguard-host.example.invalid:19092
EDGE_KAFKA_CLIENT_ID=cellguard-edge-command
EDGE_KAFKA_GROUP_ID=cellguard-edge-command
EDGE_KAFKA_TOPIC=battery-events
EDGE_IDEMPOTENCY_DB=/var/lib/cellguard/edge.sqlite
EDGE_POLL_TIMEOUT_MS=1000
EDGE_RETRY_DELAY_MS=1000

# Leave physical safety gates unset until the documented operator/sensor
# evidence files are configured on the real assembly. Missing gates deny.
# EDGE_SOURCE_GATE_FILE=/var/lib/cellguard/source-gate
# EDGE_CURRENT_GATE_FILE=/var/lib/cellguard/current-gate
# EDGE_OVF_GATE_FILE=/var/lib/cellguard/ovf-gate
