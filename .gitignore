.DS_Store
~$*
*.tmp
.env
.venv/
.claude/
.superpowers/
__pycache__/
*.pyc
archive/
node_modules/
dist/
scripts/
# 단, backend/scripts는 프로젝트 상태다 (마이그레이션 실행기).
!backend/scripts/

# Local-only presentation/report artifacts. Keep shared project state in Markdown docs.
발표자료/
설계 산출물/
클로드 보고/
*.pptx
*.docx
*.pdf

# KiCad 로컬 사용자 설정 (프로젝트 상태가 아님)
*.kicad_prl
fp-info-cache
edge/bw150/__pycache__/
# Trained model bundles are supplied out-of-band and must never be committed.
ai/artifacts/
ai/external/
ai/models/
ai/checkpoints/
ai/**/*.pt
ai/**/*.pth
ai/**/*.onnx
ai/**/*.ckpt
ai/**/*.safetensors
ai/**/*.pkl
ai/**/*.joblib
data/
frontend/test-results/
frontend/*.tsbuildinfo
